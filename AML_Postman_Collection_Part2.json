      "name": "Get Customer Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{authToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/customers/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "customers", "profile"]
        }
      }
    },
