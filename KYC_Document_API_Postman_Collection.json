									"value": "1",
									"type": "text"
								},
								{
									"key": "documentType",
									"value": "PAN_CARD",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{baseUrl}}/api/kyc/upload",
							"host": ["{{baseUrl}}"],
							"path": ["api", "kyc", "upload"]
						}
					},
					"response": []
				},
				{
					"name": "Upload Aadhaar Card",
